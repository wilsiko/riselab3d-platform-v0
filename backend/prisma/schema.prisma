generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id      String    @id @default(uuid())
  name    String
  users   User[]
  sessions AuthSession[]
  verificationTokens EmailVerificationToken[]
  clients Client[]
  printers Printer[]
  filaments Filament[]
  settings GlobalSettings?
  products Product[]
  quotes   Quote[]
}

model Client {
  id        String   @id @default(uuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  tenantId   String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([tenantId])
  @@index([name])
  @@unique([tenantId, name])
}

model User {
  id              String   @id @default(uuid())
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  tenantId        String
  email           String   @unique
  password        String   @default("")
  name            String?
  googleId        String?  @unique
  emailVerifiedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  sessions        AuthSession[]
  verificationTokens EmailVerificationToken[]
}

model AuthSession {
  id        String   @id @default(uuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
}

model Printer {
  id                           String   @id @default(uuid())
  tenant                       Tenant   @relation(fields: [tenantId], references: [id])
  tenantId                     String
  nome                         String
  brand                        String   @default("")
  model                        String   @default("")
  technology                   String   @default("FDM")
  averagePowerConsumptionWatts Float    @default(0)
  peakPowerConsumptionWatts    Float    @default(0)
  buildVolumeX                 Float    @default(0)
  buildVolumeY                 Float    @default(0)
  buildVolumeZ                 Float    @default(0)
  averagePrintSpeed            Float    @default(0)
  nozzleDiameter               Float    @default(0.4)
  isCoreXY                     Boolean  @default(false)
  isEnclosed                   Boolean  @default(false)
  status                       String   @default("ACTIVE")
  consumo_watts                Float
  custo_aquisicao              Float
  vida_util_horas              Float
  products                     Product[]
}

model Filament {
  id          String   @id @default(uuid())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  tenantId    String
  marca       String
  tipo        String
  custo_por_kg Float
  products    Product[]
}

model GlobalSettings {
  id      String  @id @default(uuid())
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  tenantId String  @unique
  custo_kwh Float
  direct_margin_percent Float @default(20)
  ecommerce_margin_percent Float @default(35)
  end_customer_margin_percent Float @default(50)
  error_rate_percent Float @default(10)
}

model Product {
  id                String      @id @default(uuid())
  tenant            Tenant      @relation(fields: [tenantId], references: [id])
  tenantId          String
  nome              String
  cor               String
  variacao          String
  sku               String      @unique
  peso_gramas       Float
  tempo_impressao_horas Float
  custo_material    Float
  custo_energia     Float
  custo_amortizacao Float
  custo_total       Float
  printer           Printer     @relation(fields: [printerId], references: [id])
  printerId         String
  filament          Filament    @relation(fields: [filamentId], references: [id])
  filamentId        String
  quoteItems        QuoteItem[]

  @@index([tenantId])
  @@index([sku])
}

model Quote {
  id           String      @id @default(uuid())
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  tenantId     String
  nome_cliente String
  data         DateTime
  notes        String?
  sale_channel String      @default("direct")
  subtotal_custo Float     @default(0)
  margem_percentual Float  @default(0)
  valor_total  Float
  publicShareToken String? @unique
  publicSharedAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt
  items        QuoteItem[]

  @@index([tenantId])
  @@index([data])
}

model QuoteItem {
  id            String   @id @default(uuid())
  quote         Quote    @relation(fields: [quoteId], references: [id])
  quoteId       String
  product       Product? @relation(fields: [productId], references: [id])
  productId     String?
  quantidade    Int
  preco_unitario Float
  snapshot_nome String?
  snapshot_sku  String?
  snapshot_material String?
  custo_base_unitario Float?
  subtotal_custo Float?
  subtotal_preco Float?
}
